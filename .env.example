# CTF Brain / MCP Console — participant client configuration.
# Your team admin gives you the server URL; you generate your own API key on the dashboard Settings page.

# The team's server (ask your admin):
BRAIN_SERVER=https://your-team-server.example

# Your personal API key, generated on the dashboard Settings page (Connect API keys).
# It is shown once. It already carries your workspace, so BRAIN_CTF is not needed.
BRAIN_TOKEN=mcp_your_generated_key

# Where this client keeps its local state (any writable directory):
BRAIN_STATE_DIR=~/.mcp-console

# A 64-char random hex you choose. It encrypts LOCAL session storage only — it is NOT the server key.
#   openssl rand -hex 32
BRAIN_VAULT_KEY=

# Optional — the API key already carries its workspace, so you normally do not set this:
# BRAIN_CTF=your-workspace-uuid
