# Participant client configuration.
# Your admin gives you the server URL; generate your own API key on the Settings page.

BRAIN_SERVER=https://your-team-server.example

# Your personal API key (generated on the Settings page; carries your workspace):
BRAIN_TOKEN=mcp_your_generated_key

# Local state directory (any writable path):
BRAIN_STATE_DIR=~/.mcp-console

# A 64-char hex you choose; encrypts this client's local session storage only.
#   openssl rand -hex 32
BRAIN_VAULT_KEY=

# Optional — the API key already carries its workspace:
# BRAIN_CTF=
